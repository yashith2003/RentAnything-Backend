### API Testing Guide for RentAnything Backend

@baseUrl = http://localhost:3008/api
@phone = +94771234567
@companyPhone = +94112345678
@email = john@example.com

### ------------------------------------------------------------------------
### AUTHENTICATION
### ------------------------------------------------------------------------

### 1. Check Email Availability
POST {{baseUrl}}/auth/check-email
Content-Type: application/json

{
  "email": "{{email}}"
}

### 2. Register Individual User
POST {{baseUrl}}/auth/register/individual
Content-Type: application/json

{
  "fullName": "John Doe",
  "email": "{{email}}",
  "phone": "{{phone}}",
  "address": "123 Main St, Colombo"
}

### 3. Register Company User
POST {{baseUrl}}/auth/register/company
Content-Type: application/json

{
  "companyName": "Tech Corp",
  "registrationNumber": "REG123456",
  "email": "info@techcorp.com",
  "phone": "{{companyPhone}}",
  "officeAddress": "456 Business Ave, Colombo"
}

### 4. Login (Triggers OTP)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "phone": "{{phone}}"
}

### 5. Verify OTP (Get JWT Token)
# @name verifyOtp
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "phone": "{{phone}}",
  "otp": "1111"
}

### Save Token
@accessToken = {{verifyOtp.response.body.data.access_token}}
@refreshToken = {{verifyOtp.response.body.data.refresh_token}}

### 6. Refresh Token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### ------------------------------------------------------------------------
### USER
### ------------------------------------------------------------------------

### 7. Get Current User Profile
GET {{baseUrl}}/user/profile
Authorization: Bearer {{accessToken}}

### 8. Get Public User Profile
GET {{baseUrl}}/user/1/public

### 9. Update User Profile
PUT {{baseUrl}}/user/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fullName": "John Updated",
  "description": "Experienced renter",
  "location": "Colombo, SL"
}

### 10. Upload Profile Picture
POST {{baseUrl}}/user/upload-dp
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="avatar.jpg"
Content-Type: image/jpeg

< ./test-assets/avatar.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### ------------------------------------------------------------------------
### ADDRESS
### ------------------------------------------------------------------------

### 11. Create Address
POST {{baseUrl}}/addresses
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "address": "No 45, Galle Road, Colombo"
}

### 12. Get User Addresses
GET {{baseUrl}}/addresses
Authorization: Bearer {{accessToken}}

### 13. Search Address (Nominatim)
GET {{baseUrl}}/addresses/search?q=Colombo

### ------------------------------------------------------------------------
### KYC
### ------------------------------------------------------------------------

### 14. Get KYC Status
GET {{baseUrl}}/kyc/status
Authorization: Bearer {{accessToken}}

### 15. Upload KYC Document (NIC_FRONT, NIC_BACK, SELFIE, etc.)
POST {{baseUrl}}/kyc/upload/NIC_FRONT
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="nic.jpg"
Content-Type: image/jpeg

< ./test-assets/nic.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 16. Get KYC Document Details
GET {{baseUrl}}/kyc/document/NIC_FRONT
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### CATEGORY
### ------------------------------------------------------------------------

### 17. Create Category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Vehicles"
}

### 18. Get All Categories
GET {{baseUrl}}/categories

### 19. Get Category Filters
GET {{baseUrl}}/categories/1/filters

### 20. Create Sub-Category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Cars",
  "parentId": 1
}

### ------------------------------------------------------------------------
### ITEMS
### ------------------------------------------------------------------------

### 21. Create Item
# @name createItem
POST {{baseUrl}}/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Mountain Bike for Rent",
  "description": "Standard mountain bike in excellent condition.",
  "categoryId": 1,
  "addressId": 1,
  "condition": "Excellent",
  "status": "available",
  "deliveryAvailable": true,
  "pickupAvailable": true,
  "rateType": "daily",
  "price": 1500,
  "vehicleDetails": {
    "vehicleNumber": "WP-CBA-1234",
    "vehicleType": "Car",
    "seatingCapacity": 5,
    "fuelType": "Petrol"
  }
}

@itemId = {{createItem.response.body.data.id}}

### 22. Upload Item Image (Draft/New Item)
POST {{baseUrl}}/items/upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="bike.jpg"
Content-Type: image/jpeg

< ./test-assets/bike.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 23. Upload Image for Existing Item
POST {{baseUrl}}/items/{{itemId}}/upload-image
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="bike_detail.jpg"
Content-Type: image/jpeg

< ./test-assets/bike_detail.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 24. Get All Items (with filters)
GET {{baseUrl}}/items?cat=1&minPrice=100&maxPrice=5000

### 25. Get Items for Map
GET {{baseUrl}}/items/map?neLat=7.0&neLng=80.0&swLat=6.8&swLng=79.8

### 26. Get Trending Items
GET {{baseUrl}}/items/trending?cat=1

### 27. Get My Items
GET {{baseUrl}}/items/my-items
Authorization: Bearer {{accessToken}}

### 28. Get My Items with Review Stats
GET {{baseUrl}}/items/my-items/reviews
Authorization: Bearer {{accessToken}}

### 29. Get Items by Owner
GET {{baseUrl}}/items/owner/1

### 30. Get Specific Item
GET {{baseUrl}}/items/{{itemId}}

### 31. Record Interaction (VIEW, CALL, CHAT)
POST {{baseUrl}}/items/{{itemId}}/interact
X-Session-Id: test-session-123
Content-Type: application/json

{
  "type": "VIEW"
}

### 32. Update Item
PATCH {{baseUrl}}/items/{{itemId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Mountain Bike for Rent - Updated",
  "condition": "Good"
}

### 33. Delete Item
DELETE {{baseUrl}}/items/{{itemId}}
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### SAVED ITEMS
### ------------------------------------------------------------------------

### 34. Toggle Save Item
POST {{baseUrl}}/items/saved/{{itemId}}/toggle
Authorization: Bearer {{accessToken}}

### 35. Get All Saved Items
GET {{baseUrl}}/items/saved
Authorization: Bearer {{accessToken}}

### 36. Check if Item is Saved
GET {{baseUrl}}/items/saved/{{itemId}}/check
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### PRICING & AVAILABILITY
### ------------------------------------------------------------------------

### 37. Set Item Pricing
POST {{baseUrl}}/pricing
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "itemId": 1,
  "rateType": "daily",
  "price": 1000
}

### 38. Get Availability for Item
GET {{baseUrl}}/availability/item/{{itemId}}

### 39. Set Item Availability (Internal/Logic check)
POST {{baseUrl}}/availability
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "itemId": 1,
  "fromDate": "2026-02-10",
  "toDate": "2026-02-20"
}

### ------------------------------------------------------------------------
### RENTALS
### ------------------------------------------------------------------------

### 40. Get All Rentals
GET {{baseUrl}}/rentals
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### REVIEWS
### ------------------------------------------------------------------------

### 41. Create Review
POST {{baseUrl}}/reviews
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "itemId": 1,
  "rating": 5,
  "feedback": "Great experience!"
}

### 42. Get Reviews for Item
GET {{baseUrl}}/reviews/item/1?page=1&limit=10

### 43. Get Reviews for User
GET {{baseUrl}}/reviews/user/1?page=1&limit=10

### 44. Get My Review for Item
GET {{baseUrl}}/reviews/item/1/my-review
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### INCIDENTS
### ------------------------------------------------------------------------

### 45. Create Incident Report
POST {{baseUrl}}/incidents
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rentalId": 1,
  "description": "The rented item was damaged.",
  "media": [
    {
      "mediaType": "image",
      "mediaUrl": "https://example.com/damage.jpg"
    }
  ]
}

### 46. Get All Incidents
GET {{baseUrl}}/incidents
Authorization: Bearer {{accessToken}}

### 47. Get Specific Incident
GET {{baseUrl}}/incidents/1
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### CHAT
### ------------------------------------------------------------------------

@otherUserId = 2

### 48. Create Chat Thread
POST {{baseUrl}}/chat/thread
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "itemId": 1,
  "otherUserId": {{otherUserId}}
}

### 49. Get All My Threads
GET {{baseUrl}}/chat/threads
Authorization: Bearer {{accessToken}}

### 50. Get Thread Details
GET {{baseUrl}}/chat/thread/1
Authorization: Bearer {{accessToken}}

### 51. Get Thread Messages
GET {{baseUrl}}/chat/thread/1/messages
Authorization: Bearer {{accessToken}}

### 52. Mark Thread as Read
POST {{baseUrl}}/chat/thread/1/read
Authorization: Bearer {{accessToken}}

### 53. Upload Chat Attachments
POST {{baseUrl}}/chat/thread/1/upload-attachments
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="files"; filename="attachment.jpg"
