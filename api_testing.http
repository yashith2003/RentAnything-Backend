### API Testing Guide for RentAnything Backend

@baseUrl = http://localhost:3008/api
@phone = +94771234567
@companyPhone = +94112345678
@email = john@example.com

### ------------------------------------------------------------------------
### AUTHENTICATION
### ------------------------------------------------------------------------

### 1. Register Individual User
POST {{baseUrl}}/auth/register/individual
Content-Type: application/json

{
  "fullName": "John Doe",
  "email": "{{email}}",
  "phone": "{{phone}}",
  "address": "123 Main St, Colombo"
}

### 2. Register Company User
POST {{baseUrl}}/auth/register/company
Content-Type: application/json

{
  "companyName": "Tech Corp",
  "registrationNumber": "REG123456",
  "email": "info@techcorp.com",
  "phone": "{{companyPhone}}",
  "officeAddress": "456 Business Ave, Colombo"
}

### 3. Login (Triggers OTP)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "phone": "{{phone}}"
}

### 4. Verify OTP (Get JWT Token)
# @name verifyOtp
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "phone": "{{phone}}",
  "otp": "1111"
}

### Save Token
@accessToken = {{verifyOtp.response.body.data.access_token}}
@refreshToken = {{verifyOtp.response.body.data.refresh_token}}

### 5. Refresh Token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### ------------------------------------------------------------------------
### USER & ADDRESS
### ------------------------------------------------------------------------

### 6. Get User Profile
GET {{baseUrl}}/user/profile
Authorization: Bearer {{accessToken}}

### 7. Create Address
POST {{baseUrl}}/addresses
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "address": "No 45, Galle Road, Colombo"
}

### 8. Get All Addresses
GET {{baseUrl}}/addresses
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### CATEGORY
### ------------------------------------------------------------------------

### 9. Create Category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Vehicles"
}

### 10. Get All Categories
GET {{baseUrl}}/categories

### 11. Create Sub-Category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Cars",
  "parentId": 1
}

### ------------------------------------------------------------------------
### ITEMS
### ------------------------------------------------------------------------

### 12. Create Item
# @name createItem
POST {{baseUrl}}/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Mountain Bike for Rent",
  "description": "Standard mountain bike in excellent condition.",
  "categoryId": 1,
  "addressId": 1,
  "condition": "Excellent",
  "status": "available",
  "deliveryAvailable": true,
  "pickupAvailable": true,
  "rateType": "daily",
  "price": 1500,
  "vehicleDetails": {
    "vehicleNumber": "WP-CBA-1234",
    "vehicleType": "Car",
    "seatingCapacity": 5,
    "fuelType": "Petrol",
    "registrationDocument": "https://example.com/reg.jpg",
    "insuranceDocument": "https://example.com/ins.jpg",
    "revenueLicense": "https://example.com/rev.jpg"
  }
}

@itemId = {{createItem.response.body.data.id}}

### 13. Get My Items
GET {{baseUrl}}/items/my-items
Authorization: Bearer {{accessToken}}

### 14. Get All Items by Category
GET {{baseUrl}}/items?cat=1

### 15. Get Specific Item
GET {{baseUrl}}/items/{{itemId}}

### 16. Update Item
PATCH {{baseUrl}}/items/{{itemId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Mountain Bike for Rent - Updated",
  "condition": "Good"
}

### 17. Delete Item
DELETE {{baseUrl}}/items/{{itemId}}
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### PRICING & AVAILABILITY
### ------------------------------------------------------------------------

### 18. Set Item Pricing
POST {{baseUrl}}/pricing
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "itemId": 1,
  "rateType": "daily",
  "price": 1000
}

### 19. Set Item Availability
POST {{baseUrl}}/availability
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "itemId": 1,
  "fromDate": "2026-02-10",
  "toDate": "2026-02-20"
}

### ------------------------------------------------------------------------
### RENTALS
### ------------------------------------------------------------------------

### 20. Get All Rentals
GET {{baseUrl}}/rentals
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### INCIDENTS
### ------------------------------------------------------------------------

### 21. Create Incident Report
POST {{baseUrl}}/incidents
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rentalId": 1,
  "description": "The rented item was damaged.",
  "media": [
    {
      "mediaType": "image",
      "mediaUrl": "https://example.com/damage.jpg"
    }
  ]
}

### 22. Get All Incidents
GET {{baseUrl}}/incidents
Authorization: Bearer {{accessToken}}

### 23. Get Specific Incident
GET {{baseUrl}}/incidents/1
Authorization: Bearer {{accessToken}}

### ------------------------------------------------------------------------
### CHAT
### ------------------------------------------------------------------------

### 24. Create Chat Thread
# Requires valid itemId (from another user) and sellerId
@sellerId = 2
POST {{baseUrl}}/chat/thread
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "itemId": 1,
  "sellerId": {{sellerId}}
}

### 25. Get Thread Messages
GET {{baseUrl}}/chat/thread/1/messages
Authorization: Bearer {{accessToken}}
